<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootContainer" styleClass="keybinds-container" alignment="CENTER" spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.comp2042.ui.KeybindsFXController">

    <Label text="Click button to rebind" styleClass="keybinds-header"/>

    <!-- Key binding rows will be added dynamically -->
    <VBox fx:id="bindingsContainer" styleClass="bindings-container" spacing="8"/>

    <Button text="Close" styleClass="keybinds-button" onAction="#handleClose"/>

    <stylesheets>
        <URL value="@../window_style.css"/>
    </stylesheets>
</VBox>
