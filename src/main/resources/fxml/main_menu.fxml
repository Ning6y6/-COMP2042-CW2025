<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.ui.MainMenuController" styleClass="main-menu-root">
   <children>
      <!-- Background Image -->
      <ImageView fx:id="backgroundImage" preserveRatio="false" smooth="true" pickOnBounds="true">
         <image>
            <Image url="@../assets/images/MainMenu.png"/>
         </image>
      </ImageView>
      
      <!-- Content Overlay -->
      <VBox alignment="CENTER" spacing="20" styleClass="main-menu-content">
         <children>
            <Label styleClass="main-menu-title" text="Tetris" />
            <Button onAction="#play" styleClass="menu-button" text="Play" />
            <Button onAction="#controls" styleClass="menu-button" text="Controls" />
            <Button onAction="#highScores" styleClass="menu-button" text="High Scores" />
            <Button onAction="#options" styleClass="menu-button" text="Options" />
            <Button onAction="#quit" styleClass="quit-button" text="Quit" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
   <stylesheets>
      <URL value="@../window_style.css"/>
   </stylesheets>
</StackPane>
